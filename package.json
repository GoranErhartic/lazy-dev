{
  "name": "lazy-dev",
  "version": "1.0.0",
  "private": true,
  "description": "PRD-driven Cursor SDK orchestration CLI",
  "type": "module",
  "bin": {
    "lazydev": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test eslint.config.js",
    "test": "vitest run",
    "dev": "tsx src/cli.tsx"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.30",
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "overrides": {
    "undici": "6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "eslint": "^9.21.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.11"
  }
}
