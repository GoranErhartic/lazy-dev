#!/bin/bash
# Lazy Dev — interactive CLI wrapper around cursor-agent and lazy.sh
#
# Usage: lazydev
#
# Requires lazy-dev to be installed globally via install.sh (~/.lazy-dev).
# Presents a menu loop:
#   1) Create new feature PRD (interactive generate-prd skill)
#   2) Implement a prepared feature (lazy.sh agent loop)
#   q) Quit

set -e

LAZY_DEV_HOME="${LAZY_DEV_HOME:-$HOME/.lazy-dev}"
LAZY_SH="${LAZY_DEV_HOME}/lazy.sh"
PRD_SH="${LAZY_DEV_HOME}/prd.sh"

# Allow running directly from repo checkout if not yet installed globally
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [ ! -x "$LAZY_SH" ] && [ -x "$SCRIPT_DIR/lazy.sh" ]; then
    LAZY_SH="$SCRIPT_DIR/lazy.sh"
fi
if [ ! -x "$PRD_SH" ] && [ -x "$SCRIPT_DIR/prd.sh" ]; then
    PRD_SH="$SCRIPT_DIR/prd.sh"
fi

# PROJECT_ROOT is the git workspace root
if _git_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    PROJECT_ROOT="$(cd "$_git_root" && pwd -P)"
else
    PROJECT_ROOT="$(pwd -P)"
fi
unset _git_root

STATE_DIR=""
FEATURES_DIR=""

resolve_state_dir() {
    STATE_DIR=$("$LAZY_SH" --bootstrap-project --print-state-dir) || return 1
    FEATURES_DIR="$STATE_DIR/features"
}

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

CURSOR_CMD=""
CURSOR_ARGS=()

resolve_cursor_cmd() {
    if command -v cursor-agent &> /dev/null; then
        CURSOR_CMD="cursor-agent"
        CURSOR_ARGS=()
    elif command -v cursor &> /dev/null; then
        CURSOR_CMD="cursor"
        CURSOR_ARGS=("agent")
    else
        log_error "Cursor CLI not found. Install cursor-agent or the Cursor CLI."
        log_info "See: https://docs.cursor.com/cli"
        exit 1
    fi
}

check_auth() {
    if ! "$CURSOR_CMD" "${CURSOR_ARGS[@]}" status &> /dev/null; then
        log_error "Not authenticated with Cursor CLI."
        log_info "Run: $CURSOR_CMD ${CURSOR_ARGS[*]} login"
        exit 1
    fi
}

preflight() {
    resolve_cursor_cmd

    if [ ! -x "$LAZY_SH" ] || [ ! -x "$PRD_SH" ]; then
        log_error "lazy-dev not properly installed at $LAZY_DEV_HOME"
        log_info "Run install.sh from the lazy-dev repository:"
        log_info "  ./install.sh"
        exit 1
    fi

    if ! command -v jq &> /dev/null; then
        log_error "jq not found. Please install it: brew install jq"
        exit 1
    fi

    resolve_state_dir || exit 1
    check_auth
}

print_menu() {
    echo ""
    echo "Lazy Dev"
    echo "────────"
    echo "1) Create new feature PRD"
    echo "2) Implement a feature"
    echo "q) Quit"
    echo ""
}

menu_interrupt() {
    echo ""
    log_info "Returning to menu…"
}

read_menu_choice() {
    local choice=""
    trap menu_interrupt INT
    read -r -p "> " choice || true
    trap - INT
    printf '%s' "$choice"
}

run_create_prd() {
    "$PRD_SH"
    local exit_code=$?
    echo ""
    if [ $exit_code -eq 0 ]; then
        log_success "PRD creation complete."
    else
        log_warn "PRD creation ended (exit code $exit_code)."
    fi
}

list_feature_names() {
    local feature_dir prd_file
    for prd_file in "$FEATURES_DIR"/*/prd.json; do
        [ -f "$prd_file" ] || continue
        feature_dir=$(dirname "$prd_file")
        basename "$feature_dir"
    done
}

feature_progress() {
    local prd_file="$1"
    local total done_count
    total=$(jq '[.userStories[]?] | length' "$prd_file" 2>/dev/null || echo "0")
    done_count=$(jq '[.userStories[]? | select(.passes == true)] | length' "$prd_file" 2>/dev/null || echo "0")
    echo "${done_count}/${total}"
}

run_implement() {
    local -a features=()
    local prd_file name description progress choice idx

    while IFS= read -r name; do
        [ -n "$name" ] && features+=("$name")
    done < <(list_feature_names | sort)

    if [ ${#features[@]} -eq 0 ]; then
        log_info "No features found in $FEATURES_DIR"
        log_info "Use option 1 to create a feature PRD first."
        return 0
    fi

    echo ""
    echo "Available features:"
    echo ""

    idx=1
    for name in "${features[@]}"; do
        prd_file="$FEATURES_DIR/$name/prd.json"
        description=$(jq -r '.description // "(no description)"' "$prd_file" 2>/dev/null || echo "(no description)")
        progress=$(feature_progress "$prd_file")
        echo "  $idx) $name — $description [$progress stories complete]"
        idx=$((idx + 1))
    done

    echo ""
    echo "  b) Back to main menu"
    echo ""

    read -r -p "Select feature: " choice || true

    if [ "$choice" = "b" ] || [ "$choice" = "B" ]; then
        return 0
    fi

    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt ${#features[@]} ]; then
        log_warn "Invalid selection."
        return 0
    fi

    name="${features[$((choice - 1))]}"
    log_info "Starting implementation for feature: $name"
    echo ""

    "$LAZY_SH" "$name"
    local exit_code=$?

    echo ""
    case $exit_code in
        0)
            log_success "Feature '$name' complete — all stories passed."
            ;;
        3)
            log_warn "Feature '$name' stuck — all remaining stories are blocked."
            ;;
        *)
            log_warn "Implementation stopped for '$name' (exit code $exit_code)."
            ;;
    esac
}

main() {
    preflight

    while true; do
        print_menu
        choice=$(read_menu_choice)

        case "$choice" in
            1) run_create_prd ;;
            2) run_implement ;;
            q|Q) echo "Goodbye."; exit 0 ;;
            "") ;;
            *) log_warn "Invalid choice. Enter 1, 2, or q." ;;
        esac
    done
}

main "$@"
