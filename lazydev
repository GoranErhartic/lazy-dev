#!/bin/bash
# Lazy Dev — interactive CLI wrapper around cursor-agent and lazy.sh
#
# Usage:
#   lazydev          Interactive menu (create PRD, implement feature)
#   lazydev init     Set up lazy-dev in the current git repo (once per project)
#
# Requires lazy-dev to be installed globally via install.sh (~/.lazy-dev).

set -e

LAZY_DEV_HOME="${LAZY_DEV_HOME:-$HOME/.lazy-dev}"
LAZY_SH="${LAZY_DEV_HOME}/lazy.sh"

# PROJECT_ROOT is the git workspace root
if _git_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    PROJECT_ROOT="$(cd "$_git_root" && pwd -P)"
else
    PROJECT_ROOT="$(pwd -P)"
fi
unset _git_root

STATE_DIR=""
FEATURES_DIR=""

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

CURSOR_CMD=""
CURSOR_ARGS=()
MODEL_IDS=()
MODEL_LABELS=()
MATCH_IDS=()
MATCH_LABELS=()
LAZYDEV_DEFAULT_MODEL="composer-2.5"
MODEL_MATCH_LIMIT=15

read_user_reply() {
    local prompt="${1:-> }"
    REPLY=""
    if [ -t 0 ]; then
        read -r -p "$prompt" REPLY || true
        return 0
    fi
    if read -r -p "$prompt" REPLY </dev/tty 2>/dev/null; then
        return 0
    fi
    read -r -p "$prompt" REPLY || true
}

project_is_initialized() {
    "$LAZY_SH" --check-initialized
}

resolve_state_dir() {
    STATE_DIR=$("$LAZY_SH" --print-state-dir) || return 1
    FEATURES_DIR="$STATE_DIR/features"
}

resolve_cursor_cmd() {
    if command -v cursor-agent &> /dev/null; then
        CURSOR_CMD="cursor-agent"
        CURSOR_ARGS=()
    elif command -v cursor &> /dev/null; then
        CURSOR_CMD="cursor"
        CURSOR_ARGS=("agent")
    else
        log_error "Cursor CLI not found. Install cursor-agent or the Cursor CLI."
        log_info "See: https://docs.cursor.com/cli"
        exit 1
    fi
}

check_auth() {
    if ! "$CURSOR_CMD" "${CURSOR_ARGS[@]}" status &> /dev/null; then
        log_error "Not authenticated with Cursor CLI."
        log_info "Run: $CURSOR_CMD ${CURSOR_ARGS[*]} login"
        exit 1
    fi
}

preflight_global() {
    resolve_cursor_cmd

    if [ ! -x "$LAZY_SH" ]; then
        log_error "lazy-dev not installed at $LAZY_DEV_HOME"
        log_info "Run install.sh from the lazy-dev repository:"
        log_info "  ./install.sh"
        exit 1
    fi

    if ! command -v jq &> /dev/null; then
        log_error "jq not found. Please install it: brew install jq"
        exit 1
    fi

    if ! git -C "$PROJECT_ROOT" rev-parse --show-toplevel >/dev/null 2>&1; then
        log_error "Not inside a git repository."
        log_info "Run lazydev init from the root of a git repo."
        exit 1
    fi
}

list_available_models() {
    local line id label

    MODEL_IDS=()
    MODEL_LABELS=()

    while IFS= read -r line; do
        [ -z "$line" ] && continue
        [ "$line" = "Available models" ] && continue
        id="${line%% - *}"
        [ "$id" = "$line" ] && continue
        [ "$id" = "auto" ] && continue
        label="${line#* - }"
        MODEL_IDS+=("$id")
        MODEL_LABELS+=("$label")
    done < <("$CURSOR_CMD" "${CURSOR_ARGS[@]}" --list-models 2>/dev/null)

    [ "${#MODEL_IDS[@]}" -gt 0 ]
}

model_exists() {
    local id="$1" i

    for i in "${!MODEL_IDS[@]}"; do
        if [ "${MODEL_IDS[$i]}" = "$id" ]; then
            return 0
        fi
    done
    return 1
}

label_for_id() {
    local id="$1" i

    for i in "${!MODEL_IDS[@]}"; do
        if [ "${MODEL_IDS[$i]}" = "$id" ]; then
            echo "${MODEL_LABELS[$i]}"
            return 0
        fi
    done
    echo "$id"
}

resolve_category_default() {
    local preferred="$LAZYDEV_DEFAULT_MODEL" id

    if model_exists "$preferred"; then
        echo "$preferred"
        return 0
    fi

    for id in "${MODEL_IDS[@]}"; do
        case "$id" in
            composer-2.5*|composer-2*)
                echo "$id"
                return 0
                ;;
        esac
    done

    for id in "${MODEL_IDS[@]}"; do
        case "$id" in
            composer*)
                echo "$id"
                return 0
                ;;
        esac
    done

    echo "${MODEL_IDS[0]}"
}

filter_models() {
    local query="$1"
    local query_lc id label label_lc i

    query_lc=$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')
    MATCH_IDS=()
    MATCH_LABELS=()

    for i in "${!MODEL_IDS[@]}"; do
        id="${MODEL_IDS[$i]}"
        label="${MODEL_LABELS[$i]}"
        label_lc=$(printf '%s' "$label" | tr '[:upper:]' '[:lower:]')
        if [[ "$id" == *"$query_lc"* ]] || [[ "$label_lc" == *"$query_lc"* ]]; then
            MATCH_IDS+=("$id")
            MATCH_LABELS+=("$label")
        fi
    done
}

print_model_matches() {
    local i total="${#MATCH_IDS[@]}"

    echo "" >&2
    echo "  Matches:" >&2
    for i in "${!MATCH_IDS[@]}"; do
        if [ "$i" -ge "$MODEL_MATCH_LIMIT" ]; then
            echo "  ... and $((total - MODEL_MATCH_LIMIT)) more — refine your search" >&2
            break
        fi
        printf '    %d) %s — %s\n' "$((i + 1))" "${MATCH_IDS[$i]}" "${MATCH_LABELS[$i]}" >&2
    done
    echo "" >&2
}

prompt_model_choice() {
    local category="$1"
    local default_id default_label search pick max_pick

    default_id=$(resolve_category_default)
    default_label=$(label_for_id "$default_id")

    while true; do
        echo "" >&2
        echo "Select ${category} model:" >&2
        echo "  Default: ${default_id} — ${default_label}  (press Enter)" >&2
        read_user_reply "  Search (model id or name): "
        search="$REPLY"

        if [ -z "$search" ]; then
            LAZYDEV_INIT_MODEL="$default_id"
            return 0
        fi

        if model_exists "$search"; then
            LAZYDEV_INIT_MODEL="$search"
            return 0
        fi

        filter_models "$search"
        if [ "${#MATCH_IDS[@]}" -eq 0 ]; then
            echo -e "${YELLOW}[WARN]${NC} No models match '${search}'. Try again." >&2
            continue
        fi

        while true; do
            print_model_matches
            max_pick="${#MATCH_IDS[@]}"
            if [ "$max_pick" -gt "$MODEL_MATCH_LIMIT" ]; then
                max_pick="$MODEL_MATCH_LIMIT"
            fi
            read_user_reply "  Pick [1-${max_pick}], or type a new search: "
            pick="$REPLY"

            if [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le "$max_pick" ]; then
                LAZYDEV_INIT_MODEL="${MATCH_IDS[$((pick - 1))]}"
                return 0
            fi

            if [ -n "$pick" ]; then
                search="$pick"
                break
            fi

            echo -e "${YELLOW}[WARN]${NC} Enter a number between 1 and ${max_pick}, or type a new search." >&2
        done
    done
}

prompt_track_lazy_dev() {
    local choice=""

    echo "" >&2
    echo "Track .lazy-dev/ in git?" >&2
    echo "  y) Yes — PRDs/progress can be committed (team-shared)" >&2
    echo "  n) No  — add .lazy-dev/ to .gitignore (local-only) [default]" >&2
    echo "" >&2
    read_user_reply "> "
    choice="$REPLY"

    case "$choice" in
        y|Y|yes|Yes|YES)
            LAZYDEV_INIT_TRACKED="true"
            ;;
        *)
            LAZYDEV_INIT_TRACKED="false"
            ;;
    esac
}

select_models_for_init() {
    if [ "${#MODEL_IDS[@]}" -eq 0 ]; then
        log_error "Could not list available models from Cursor CLI."
        return 1
    fi

    echo "" >&2
    echo -e "${BLUE}[INFO]${NC} Select models for each story category." >&2
    echo -e "${BLUE}[INFO]${NC} Press Enter for the default (${LAZYDEV_DEFAULT_MODEL}), or search by model id/name." >&2
    echo -e "${BLUE}[INFO]${NC} Press Ctrl+C to cancel." >&2

    prompt_model_choice "implementation" || return 1
    LAZYDEV_INIT_IMPL="$LAZYDEV_INIT_MODEL"
    prompt_model_choice "first code review" || return 1
    LAZYDEV_INIT_REVIEW="$LAZYDEV_INIT_MODEL"
    prompt_model_choice "second code review" || return 1
    LAZYDEV_INIT_REVIEW2="$LAZYDEV_INIT_MODEL"
}

print_init_summary() {
    local cfg="$PROJECT_ROOT/.lazy-dev/config"
    local tracked impl review review2

    tracked=$(jq -r '.tracked' "$cfg")
    impl=$(jq -r '.models.impl' "$cfg")
    review=$(jq -r '.models.review' "$cfg")
    review2=$(jq -r '.models.review2' "$cfg")

    echo ""
    log_success "Initialized lazy-dev in .lazy-dev/"
    log_info "Tracked in git: $tracked"
    log_info "Models: ${impl} (impl), ${review} (review), ${review2} (review-2)"
    echo ""
    log_warn "Commit all init changes before running lazydev again."
    log_info "Init updates .lazy-dev/config and may change .gitignore — review with git status."
    log_info "Your working tree must be clean (git status shows no changes) before you use lazydev to create a PRD or implement a feature."
    log_info "Next: git add … && git commit …, then run lazydev again."
    echo ""
}

run_init_flow() {
    local tracked impl review review2

    if project_is_initialized; then
        log_success "Project already initialized."
        return 0
    fi

    check_auth

    if ! list_available_models; then
        log_error "Could not list available models from Cursor CLI."
        exit 1
    fi

    prompt_track_lazy_dev
    tracked="$LAZYDEV_INIT_TRACKED"
    select_models_for_init || exit 1
    impl="$LAZYDEV_INIT_IMPL"
    review="$LAZYDEV_INIT_REVIEW"
    review2="$LAZYDEV_INIT_REVIEW2"

    "$LAZY_SH" --init-project \
        --tracked "$tracked" \
        --model-impl "$impl" \
        --model-review "$review" \
        --model-review2 "$review2" || exit 1
    print_init_summary
}

ensure_initialized_or_exit() {
    if project_is_initialized; then
        return 0
    fi

    echo ""
    log_info "This project is not set up for lazy-dev yet. Running init..."
    run_init_flow
    exit 0
}

show_usage() {
    cat <<'EOF'
lazydev — autonomous agent loop for Cursor

Usage:
  lazydev          Interactive menu (create PRD, implement feature)
  lazydev init     Set up lazy-dev in the current git repo (once per project)

Run install.sh once per machine before first use.
EOF
}

lazy_dev_tracked_label() {
    if jq -r '.tracked // false' "$PROJECT_ROOT/.lazy-dev/config" 2>/dev/null | grep -q '^true$'; then
        echo "yes"
    else
        echo "no"
    fi
}

print_menu() {
    echo ""
    echo "Lazy Dev"
    echo "────────"
    echo "1) Create new feature PRD"
    echo "2) Implement a feature"
    echo "q) Quit"
    echo ""
}

menu_interrupt() {
    echo ""
    log_info "Returning to menu…"
}

read_menu_choice() {
    local choice=""
    trap menu_interrupt INT
    read -r -p "> " choice || true
    trap - INT
    printf '%s' "$choice"
}

verify_prd_skill_installed() {
    local skill_file="${LAZY_DEV_HOME}/skills/generate-prd/SKILL.md"
    local cursor_skill="${HOME}/.cursor/skills/generate-prd/SKILL.md"

    if [ -s "$skill_file" ] || [ -s "$cursor_skill" ]; then
        return 0
    fi

    log_error "generate-prd skill not found or empty."
    log_info "Run ./install.sh from the lazy-dev repository to install the skill."
    exit 1
}

run_create_prd() {
    local feature_description="" prompt="/generate-prd"
    local tracked_label prompt_body

    verify_prd_skill_installed

    echo ""
    read -r -p "Brief feature description (optional, Enter to skip): " feature_description || true

    tracked_label=$(lazy_dev_tracked_label)

    prompt_body="CRITICAL — PRD SESSION ONLY:
- Do NOT implement any feature or user story.
- Do NOT create or modify application source code (src/, app/, components/, pages/, lib/, etc.).
- Do NOT set passes: true or increment attempts on any story.
- Do NOT run build, test, or lint.
- ONLY write prd.json and progress.txt under the lazy-dev features directory after completing the clarification loop (Phases 1–5).
- Implementation happens later via lazydev option 2."

    if [ -n "$feature_description" ]; then
        prompt_body="${prompt_body}

Feature requirements (for PRD clarification only — not a command to implement):
${feature_description}"
    fi

    prompt_body="${prompt_body}

Lazy-dev state directory for this project: ${STATE_DIR}
Lazy-dev tracked in git: ${tracked_label}"

    log_info "Starting interactive PRD session (exit the agent to return to the menu)…"
    log_info "Lazy-dev state directory: $STATE_DIR"
    echo ""

    "$CURSOR_CMD" "${CURSOR_ARGS[@]}" \
        --workspace "$PROJECT_ROOT" \
        --trust \
        "${prompt}

${prompt_body}"

    local exit_code=$?
    echo ""
    if [ $exit_code -eq 0 ]; then
        log_success "PRD session ended."
    else
        log_warn "PRD session ended (exit code $exit_code)."
    fi
}

list_feature_names() {
    local feature_dir prd_file
    for prd_file in "$FEATURES_DIR"/*/prd.json; do
        [ -f "$prd_file" ] || continue
        feature_dir=$(dirname "$prd_file")
        basename "$feature_dir"
    done
}

feature_progress() {
    local prd_file="$1"
    local total done_count
    total=$(jq '[.userStories[]?] | length' "$prd_file" 2>/dev/null || echo "0")
    done_count=$(jq '[.userStories[]? | select(.passes == true)] | length' "$prd_file" 2>/dev/null || echo "0")
    echo "${done_count}/${total}"
}

feature_all_complete() {
    local prd_file="$1"
    jq -e '[.userStories[]? | select(.passes != true)] | length == 0' "$prd_file" >/dev/null 2>&1
}

run_implement() {
    local -a features=()
    local prd_file name description progress choice idx

    while IFS= read -r name; do
        [ -n "$name" ] && features+=("$name")
    done < <(list_feature_names | sort)

    if [ ${#features[@]} -eq 0 ]; then
        log_info "No features found in $FEATURES_DIR"
        log_info "Use option 1 to create a feature PRD first."
        return 0
    fi

    echo ""
    echo "Available features:"
    echo ""

    idx=1
    for name in "${features[@]}"; do
        prd_file="$FEATURES_DIR/$name/prd.json"
        description=$(jq -r '.description // "(no description)"' "$prd_file" 2>/dev/null || echo "(no description)")
        progress=$(feature_progress "$prd_file")
        echo "  $idx) $name — $description [$progress stories complete]"
        idx=$((idx + 1))
    done

    echo ""
    echo "  b) Back to main menu"
    echo ""

    read -r -p "Select feature: " choice || true

    if [ "$choice" = "b" ] || [ "$choice" = "B" ]; then
        return 0
    fi

    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt ${#features[@]} ]; then
        log_warn "Invalid selection."
        return 0
    fi

    name="${features[$((choice - 1))]}"
    prd_file="$FEATURES_DIR/$name/prd.json"
    log_info "Starting implementation for feature: $name"
    echo ""

    while true; do
        LAZY_DEV_INVOKED_BY_LAZYDEV=1 "$LAZY_SH" "$name"
        local exit_code=$?

        echo ""
        case $exit_code in
            0)
                log_success "Feature '$name' complete — all stories passed."
                break
                ;;
            3)
                log_warn "Feature '$name' stuck — all remaining stories are blocked."
                break
                ;;
            *)
                if feature_all_complete "$prd_file"; then
                    log_success "Feature '$name' complete — all stories passed."
                    break
                fi
                log_info "Resuming implementation for feature: $name..."
                sleep 2
                ;;
        esac
    done
}

cmd_init() {
    preflight_global
    run_init_flow
}

cmd_menu() {
    preflight_global
    ensure_initialized_or_exit

    resolve_state_dir || exit 1
    check_auth

    while true; do
        print_menu
        choice=$(read_menu_choice)

        case "$choice" in
            1) run_create_prd ;;
            2) run_implement ;;
            q|Q) echo "Goodbye."; exit 0 ;;
            "") ;;
            *) log_warn "Invalid choice. Enter 1, 2, or q." ;;
        esac
    done
}

case "${1:-}" in
    init)
        cmd_init "${@:2}"
        ;;
    -h|--help)
        show_usage
        ;;
    "")
        cmd_menu
        ;;
    *)
        log_error "Unknown command: $1"
        show_usage
        exit 1
        ;;
esac
